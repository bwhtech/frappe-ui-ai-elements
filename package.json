{
	"name": "frappe-ui-ai-elements",
	"version": "1.0.0",
	"description": "AI chat and agent components for Vue 3, built on frappe-ui. A port of shadcn AI Elements.",
	"keywords": [
		"ai",
		"ai-elements",
		"ai-sdk",
		"chat",
		"frappe-ui",
		"katex",
		"mermaid",
		"vue"
	],
	"homepage": "https://github.com/bwhtech/frappe-ui-ai-elements#readme",
	"bugs": {
		"url": "https://github.com/bwhtech/frappe-ui-ai-elements/issues"
	},
	"license": "MIT",
	"author": "Hussain Nagaria",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bwhtech/frappe-ui-ai-elements.git"
	},
	"files": [
		"dist",
		"src",
		"tailwind.js",
		"NOTICE",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./src/styles.css",
		"./tailwind": "./tailwind.js"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build -c vite.lib.config.ts && node scripts/vue-tsc.cjs -p tsconfig.lib.json",
		"build:demo": "vite build",
		"build:demo:dist": "DEMO_FROM_DIST=1 vite build",
		"typecheck": "node scripts/vue-tsc.cjs --noEmit -p tsconfig.json",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "npm run fmt:check && npm run lint && npm run typecheck",
		"changeset": "changeset",
		"prepublishOnly": "npm run check && npm run build"
	},
	"dependencies": {
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"katex": "^0.19.1",
		"marked": "^15.0.12",
		"pele": "^1.13.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@vitejs/plugin-vue": "^6.0.10",
		"ai": "^7.0.150",
		"autoprefixer": "^10.6.1",
		"frappe-ui": "^1.1.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"postcss": "^8.5.31",
		"tailwindcss": "^3.4.19",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vue": "^3.5.44",
		"vue-router": "^4.6.4",
		"vue-tsc": "^3.3.13"
	},
	"peerDependencies": {
		"ai": ">=7.0.0",
		"frappe-ui": "^1.1.0",
		"vue": ">=3.5.0"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		}
	}
}
